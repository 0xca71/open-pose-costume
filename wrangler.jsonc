{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-pose-costume",
  "main": "worker/site.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/__opc-image/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
